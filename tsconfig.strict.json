{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "allowJs": true,
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "module": "none",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": [],
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  /* strictNullChecks — 전체 js/*.js를 엄격 검사한다.
     (리프 모듈부터 시작해 mateon.js까지 단계적으로 확장 완료) */
  "include": ["js/*.js", "js/globals.d.ts"],
  "exclude": ["js/vendor/**", "node_modules/**", "dist/**", "android/**", "ios/**", "release/**", "ota/**"]
}
