{
  "name": "mateon-app",
  "version": "0.2.0",
  "private": true,
  "description": "MATE:ON mobile app for living better together",
  "scripts": {
    "dev": "node server.js",
    "test": "node test-score.js && node test-smoke.js",
    "build": "node scripts/build-app.js",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android:debug": "npm run build && cap sync android && node scripts/build-android.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4"
  }
}
