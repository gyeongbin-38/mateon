<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MATE:ON"
            android:textSize="12sp"
            android:textColor="#8A8F98" />

        <TextView
            android:id="@+id/wg_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1C1C21" />

        <TextView
            android:id="@+id/wg_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#4B4F57"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/wg_mission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="#6366F1"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingStart="10dp" />
</LinearLayout>
